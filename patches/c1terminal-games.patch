+	case 0:
+		character = ' '
+	case '─', '━', '⎺', '⎻', '⎼', '⎽':
+		character = '-'
+	case '│', '┃':
+		character = '|'
+	case '┌', '┐', '└', '┘', '├', '┤', '┬', '┴', '┼':
+		character = '+'
+	case '☆', '★':
+		character = '*'
+	}
+	bmp, ok := cjkBitmap(character)
+	if !ok {
+		bmp, _ = cjkBitmap('?')
+	}
+	width := cells * CellWidth
+	if cells == 1 {
+		for row := 0; row < GlyphHeight; row++ {
+			if bmp[row*2+1] != 0 {
+				bmp, _ = cjkBitmap('?')
+				break
+			}
+		}
+	}
+	for column := 0; column < width; column++ {
+		for row := 0; row < GlyphHeight; row++ {
+			set := bmp[row*2+column/8]&(0x80>>(column%8)) != 0
+			if underline && row == GlyphHeight-2 {
+				set = true
+			}
+			if bold && cells == 1 && column > 0 {
+				set = set || bmp[row*2+(column-1)/8]&(0x80>>((column-1)%8)) != 0
+			}
+			setPixel(frame, x+column, y+row, set != inverse)
+		}
+	}
