diff --git a/C1Terminal/cmd/c1term/stream.go b/C1Terminal/cmd/c1term/stream.go
new file mode 100644
index 0000000..2c570d6
--- /dev/null
+++ b/C1Terminal/cmd/c1term/stream.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"golang.org/x/text/encoding/simplifiedchinese"
+	"golang.org/x/text/transform"
+)
+
+type utf8Stream struct {
+	pending []byte
+}
+
+func (s *utf8Stream) push(chunk []byte) []byte {
+	s.pending = append(s.pending, chunk...)
+	var output []byte
+	consumed := 0
+	for consumed < len(s.pending) && utf8.FullRune(s.pending[consumed:]) {
+		r, n := utf8.DecodeRune(s.pending[consumed:])
+		output = utf8.AppendRune(output, r)
+		consumed += n
+	}
+	s.pending = append(s.pending[:0], s.pending[consumed:]...)
+	return output
+}
+
+func commandArgs(line string) ([]string, error) {
+	if line == "" {
+		return []string{"/bin/bash", "--noprofile", "--norc", "-i"}, nil
+	}
+	args := strings.Fields(line)
+	if len(args) == 0 {
+		return nil, fmt.Errorf("C1TERM_EXEC is empty after trimming whitespace")
+	}
+	return args, nil
+}
+
+func usesGBK(value string) (bool, error) {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "utf8", "utf-8":
+		return false, nil
+	case "gbk":
+		return true, nil
+	default:
+		return false, fmt.Errorf("unsupported C1TERM_ENCODING %q", value)
+	}
+}
+
+func outputReader(reader io.Reader, gbk bool) io.Reader {
+	if gbk {
+		return transform.NewReader(reader, simplifiedchinese.GBK.NewDecoder())
+	}
+	return reader
+}
+
+func inputBytes(data []byte, gbk bool) ([]byte, error) {
+	if gbk {
+		return simplifiedchinese.GBK.NewEncoder().Bytes(data)
+	}
+	return data, nil
+}
+
+func redrawDue(dirty bool, lastChange, dirtySince, now time.Time) bool {
+	return dirty && (now.Sub(lastChange) >= 100*time.Millisecond || now.Sub(dirtySince) >= 250*time.Millisecond)
+}
diff --git a/C1Terminal/cmd/c1term/stream_test.go b/C1Terminal/cmd/c1term/stream_test.go
new file mode 100644
index 0000000..6ea062e
--- /dev/null
+++ b/C1Terminal/cmd/c1term/stream_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+)
+
+func TestUTF8EveryChunkBoundary(t *testing.T) {
+	text := "\x1b[31m北大侠客行\x1b[0m test中A"
+	for split := 0; split <= len(text); split++ {
+		var stream utf8Stream
+		out := append(stream.push([]byte(text[:split])), stream.push([]byte(text[split:]))...)
+		if string(out) != text || len(stream.pending) != 0 {
+			t.Fatalf("split %d: %q, pending %x", split, out, stream.pending)
+		}
+	}
+	var stream utf8Stream
+	var out []byte
+	for _, b := range []byte(text) {
+		chunk := stream.push([]byte{b})
+		if !utf8.Valid(chunk) {
+			t.Fatal("invalid UTF8 emitted")
+		}
+		out = append(out, chunk...)
+	}
+	if string(out) != text {
+		t.Fatal(string(out))
+	}
+}
+
+func TestInvalidUTF8DoesNotLoseFollowingText(t *testing.T) {
+	var stream utf8Stream
+	if got := string(stream.push([]byte{0xff, 'A'})); got != "\ufffdA" {
+		t.Fatal(got)
+	}
+}
+
+func TestGBKRoundTripPreservesANSI(t *testing.T) {
+	text := "\x1b[32m北大侠客行\x1b[0m\r\nlook\r"
+	encoded, err := inputBytes([]byte(text), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Equal(encoded, []byte(text)) {
+		t.Fatal("not encoded")
+	}
+	decoded, err := io.ReadAll(outputReader(&oneByteReader{data: encoded}, true))
+	if err != nil || string(decoded) != text {
+		t.Fatalf("%q %v", decoded, err)
+	}
+	plain, _ := inputBytes([]byte(text), false)
+	if string(plain) != text {
+		t.Fatal("default encoding changed")
+	}
+}
+
+type oneByteReader struct{ data []byte }
+
+func (r *oneByteReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, io.EOF
+	}
+	p[0] = r.data[0]
+	r.data = r.data[1:]
+	return 1, nil
+}
+
+func TestEncodingAndCommandOptions(t *testing.T) {
+	if _, err := commandArgs(" \t\n"); err == nil {
+		t.Fatal("accepted empty command")
+	}
+	args, err := commandArgs("/usr/bin/telnet mud.pkuxkx.net 8080")
+	if err != nil || strings.Join(args, " ") != "/usr/bin/telnet mud.pkuxkx.net 8080" {
+		t.Fatal(args, err)
+	}
+	args, err = commandArgs("")
+	if err != nil || args[0] != "/bin/bash" {
+		t.Fatal(args, err)
+	}
+	if yes, err := usesGBK("GBK"); err != nil || !yes {
+		t.Fatal(yes, err)
+	}
+	if _, err := usesGBK("unknown"); err == nil {
+		t.Fatal("accepted unknown codec")
+	}
+}
+
+func TestContinuousOutputHasBoundedRefreshLatency(t *testing.T) {
+	start := time.Unix(100, 0)
+	for ms := 0; ms < 250; ms += 25 {
+		now := start.Add(time.Duration(ms) * time.Millisecond)
+		if redrawDue(true, now, start, now) {
+			t.Fatalf("early refresh at %d", ms)
+		}
+	}
+	end := start.Add(250 * time.Millisecond)
+	if !redrawDue(true, end, start, end) {
+		t.Fatal("continuous output starved")
+	}
+	if !redrawDue(true, start, start, start.Add(100*time.Millisecond)) {
+		t.Fatal("quiet frame not rendered")
+	}
+	if redrawDue(false, start, start, end) {
+		t.Fatal("rendered clean frame")
+	}
+}
