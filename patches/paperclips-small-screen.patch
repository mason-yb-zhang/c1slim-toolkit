+package main
+
+import (
+	"fmt"
+	"strings"
+	"unicode"
+
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/x/ansi"
+)
+
+func (m model) compact() bool {
+	return (m.width > 0 && m.width <= 60) || (m.height > 0 && m.height <= 22)
+}
+
+func (m model) compactTabCount() int {
+	if m.state.CurrentStage == 1 {
+		return 6
+	}
+	return 2
+}
+
+func (m model) compactProjectList() []Project {
+	projects := visibleProjects(m.state, m.state.CurrentStage)
+	// The transition is tagged Stage 3, but must be reachable from Earth.
+	if m.state.CurrentStage == 2 {
+		for _, p := range allProjects() {
+			if p.Name == "Space Exploration" {
+				projects = append(projects, p)
+			}
+		}
+	}
+	return projects
+}
+
+func (m *model) normalizeCompactNavigation() {
+	if !m.compact() {
+		return
+	}
+	if m.viewStage != 0 && m.viewStage != m.state.CurrentStage {
+		m.activeTab, m.selProject, m.bodyOffset = 0, 0, 0
+	}
+	m.viewStage = m.state.CurrentStage
+	m.activeTab = clampInt(m.activeTab, 0, m.compactTabCount()-1)
+	m.selProject = clampInt(m.selProject, 0, max(0, len(m.compactProjectList())-1))
+	m.bodyOffset = clampInt(m.bodyOffset, 0, m.compactMaxScroll())
+}
+
+func (m *model) handleCompactKey(msg tea.KeyMsg) bool {
+	if msg.Type == tea.KeyRunes {
+		r := string(msg.Runes)
+		if r == "j" || r == "k" {
+			if r == "j" {
+				m.bodyOffset++
+			} else {
+				m.bodyOffset--
+			}
+			return true
+		}
+		if r == "q" {
+			m.err = fmt.Errorf("QUIT")
+			return true
+		}
+		if m.saveMenu {
+			return false // n/d and slot keys belong exclusively to the save menu.
+		}
+		if r == "z" {
+			m.compactNextTab()
+			return true
+		}
+	}
+	if m.saveMenu {
+		return msg.Type != tea.KeyRunes && msg.Type != tea.KeyEscape && msg.Type != tea.KeyCtrlC
+	}
+	switch msg.Type {
+	case tea.KeyTab:
+		m.compactNextTab()
+		return true
+	case tea.KeyUp, tea.KeyDown:
+		delta := 1
+		if msg.Type == tea.KeyUp {
+			delta = -1
+		}
+		if m.activeTab == 1 {
+			n := len(m.compactProjectList())
+			if n > 0 {
+				m.selProject = (m.selProject + delta + n) % n
+			}
+			m.bodyOffset = 0
+		} else if m.state.CurrentStage == 3 {
+			m.probeStatSel = (m.probeStatSel + delta + 8) % 8
+		}
+		return true
+	case tea.KeyLeft, tea.KeyRight:
+		if m.state.CurrentStage == 3 && m.activeTab == 0 {
+			delta := 1
+			if msg.Type == tea.KeyLeft {
+				delta = -1
+			}
+			m.adjustProbeStat(delta)
+		}
+		return true
+	}
+	return false
+}
+
+func (m *model) compactNextTab() {
+	m.activeTab = (m.activeTab + 1) % m.compactTabCount()
+	m.selProject, m.bodyOffset = 0, 0
+}
+
+// Strip styling and pictograms before wrapping; the device font has no emoji.
+func compactText(s string) string {
+	s = strings.NewReplacer("✅", "[done]", "▶", ">", "⏸", "", "✓", "OK", "📌", "", "💡", "", "💬", "", "🌟", "").Replace(ansi.Strip(s))
+	return strings.Map(func(r rune) rune {
+		if r >= 0x1f000 && r <= 0x1faff || r == 0xfe0f || r == 0x200d {
+			return -1
+		}
+		if unicode.IsControl(r) && r != '\n' {
+			return ' '
+		}
+		return r
+	}, s)
+}
+
+func compactLines(text string, width int) []string {
+	if width <= 0 {
+		return nil
+	}
+	var lines []string
+	for _, line := range strings.Split(strings.TrimSpace(compactText(text)), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		for _, wrapped := range strings.Split(ansi.Hardwrap(line, width, false), "\n") {
+			// A single wide glyph cannot fit a one-cell terminal.
+			lines = append(lines, ansi.Truncate(wrapped, width, ""))
+		}
+	}
+	return lines
+}
+
+type compactPage struct {
+	header, body, footer []string
+}
+
+func (m model) compactPage() compactPage {
+	s := m.state
+	p := compactPage{}
+	p.header = append(p.header, fmt.Sprintf("回形针 阶段%d 存档%d | 针:%s", s.CurrentStage, m.currentSlot, formatBig(s.PaperclipsTotal)))
+	p.header = append(p.header, fmt.Sprintf("$%.2f 库存:%s 丝:%s 价:%.2f", s.Funds, formatBig(s.UnsoldStock), formatBig(s.WireInches), s.PricePerClip))
+	tabs := []string{"主业", "项目", "策略", "投资", "计算", "无人机"}
+	if s.CurrentStage == 2 {
+		tabs = []string{"蜂群", "项目"}
+	} else if s.CurrentStage == 3 {
+		tabs = []string{"探针", "项目"}
+	}
+	for i := range tabs {
+		if i == m.activeTab {
+			tabs[i] = "[" + tabs[i] + "]"
+		}
+	}
+	tabLine := strings.Join(tabs, " ")
+	if ansi.StringWidth(tabLine) > m.width {
+		tabLine = fmt.Sprintf("%d/%d %s z/Tab", m.activeTab+1, len(tabs), tabs[clampInt(m.activeTab, 0, len(tabs)-1)])
+	}
+	p.header = append(p.header, tabLine)
+	var b strings.Builder
+	if m.saveMenu {
+		p.header = append(p.header, "存档菜单 (n覆盖当前槽 / d删除当前槽)")
+		for _, info := range m.slotInfos {
+			marker := " "
+			if info.Slot == m.currentSlot {
+				marker = ">"
+			}
+			if info.Exists {
+				fmt.Fprintf(&b, "%s%d: 针%s $%.0f 阶段%d\n  %s\n", marker, info.Slot, formatBig(info.Paperclips), info.Funds, info.Stage, info.Time)
+			} else {
+				fmt.Fprintf(&b, "%s%d: 空\n", marker, info.Slot)
+			}
+		}
+		p.footer = []string{"1-5读取 !@#$%写入对应槽", "n新建 d删除 S关闭 j/k滚动", "q/Esc保存退出"}
+	} else {
+		if m.activeTab == 1 {
+			m.compactProjects(&p, &b)
+		} else if s.CurrentStage == 3 {
+			m.compactProbes(&p, &b)
+		} else if s.CurrentStage == 2 {
+			compactSwarm(&b, s)
+		} else {
+			switch m.activeTab {
+			case 0:
+				compactBusiness(&b, s, m.height <= 10)
+			case 2:
+				renderYomiTab(&b, s)
+			case 3:
+				renderInvestTab(&b, s)
+			case 4:
+				renderComputingTab(&b, s)
+			case 5:
+				renderDronesTab(&b, s)
+			}
+		}
+		p.footer = m.compactControls()
+	}
+	if m.height <= 10 {
+		label := tabs[clampInt(m.activeTab, 0, len(tabs)-1)]
+		if m.saveMenu {
+			label = "[存档]"
+		}
+		money := fmt.Sprintf("%.2f", s.Funds)
+		if len(money) > 9 {
+			money = fmt.Sprintf("%.2g", s.Funds)
+		}
+		hud := fmt.Sprintf("%d%s 针:%s $%s", s.CurrentStage, label, formatBig(s.PaperclipsTotal), money)
+		detail := fmt.Sprintf("槽%d 库存:%s 丝:%s 价:%.2f", m.currentSlot, formatBig(s.UnsoldStock), formatBig(s.WireInches), s.PricePerClip)
+		if m.saveMenu {
+			detail = fmt.Sprintf("槽%d n覆盖新建 d删除当前槽", m.currentSlot)
+		} else if m.activeTab == 1 || s.CurrentStage == 3 {
+			detail = p.header[len(p.header)-1]
+		}
+		p.header = []string{hud, detail}
+		p.footer = m.shortControls()
+		fmt.Fprintln(&b, "\nz/Tab切页 j/k滚动 S存档 q/Esc保存退出")
+	}
+	if m.message != "" {
+		// Full feedback remains scrollable even when the fixed status is clipped.
+		b.WriteString("\n提示: " + m.message + "\n")
+	}
+	p.body = compactLines(b.String(), m.width)
+	var footer []string
+	for _, line := range p.footer {
+		footer = append(footer, compactLines(line, m.width)...)
+	}
+	p.footer = footer
+	return p
+}
+
+func compactBusiness(b *strings.Builder, s *GameState, short bool) {
+	if s.AutoClippers == 0 {
+		if short {
+			fmt.Fprintln(b, "开局: a制作，等自动售出赚钱。")
+			fmt.Fprintf(b, "攒$%.0f按b买自动机；w补丝。\n", s.AutoClipperCost)
+		} else {
+			fmt.Fprintln(b, "开局: 按a弯针，等待自动售出赚钱。")
+			fmt.Fprintf(b, "攒$%.0f按b买自动机；缺丝按w买丝。\n", s.AutoClipperCost)
+		}
+	}
+	fmt.Fprintf(b, "针:%d 库存:%d 资金:$%.2f\n", s.PaperclipsTotal, s.UnsoldStock, s.Funds)
+	fmt.Fprintf(b, "售价:$%.2f 需求:%.0f%% 收入:$%.2f\n", s.PricePerClip, s.PublicDemand, s.TotalRevenue)
+	fmt.Fprintf(b, "丝:%d w买1000x%.2f丝:$%.2f\n", s.WireInches, s.WireEfficiency, s.WireCost)
+	fmt.Fprintf(b, "自动机:%d b购买:$%.0f (资金$5解锁)\n", s.AutoClippers, s.AutoClipperCost)
+	fmt.Fprintf(b, "产量:%.0f/s 自动机:%.1f/s\n", s.ClipsPerSec, float64(s.AutoClippers)*s.AutoClipperMult)
+	fmt.Fprintf(b, "营销:Lv%d m购买:$%.0f\n", s.MarketingLevel, s.MarketingCost)
+	fmt.Fprintf(b, "p处理器:$%.0f e内存:$%.0f\n", s.ProcessorCost, s.MemoryCost)
+	fmt.Fprintf(b, "运算:%.0f/%.0f 创意:%.0f 信任:%.0f\n", s.Ops, s.OpsCapacity, s.Creativity, s.Trust)
+	fmt.Fprintf(b, "巨型机:%d M购买:$%.0f 产量:%.0f/s\n", s.MegaClippers, s.MegaClipperCost, float64(s.MegaClippers)*s.MegaClipperMult)
+	fmt.Fprintln(b, "75自动机后到项目页研究MegaClippers。")
+	fmt.Fprintln(b, "后续: HypnoDrones + 100信任，研究释放。")
+}
+
+func compactSwarm(b *strings.Builder, s *GameState) {
+	fmt.Fprintln(b, "先到项目页研究无人机与电网。")
+	fmt.Fprintf(b, "针:%d 丝:%d 资金:$%.2f\n", s.PaperclipsTotal, s.WireInches, s.Funds)
+	fmt.Fprintf(b, "h采集机:%d 下台$%.0f\nw造丝机:%d 下台$%.0f\nf工厂:%d 下台$%.0f\ns太阳能:%d 下座$%.0f\nb电池:%d 下组$%.0f\n", s.HarvesterDrones, s.HarvesterCost, s.WireDrones, s.WireDroneCost, s.ClipFactories, s.FactoryCost, s.SolarFarms, s.FarmCost, s.Batteries, s.BatteryCost)
+	fmt.Fprintf(b, "电力:产%.1f/耗%.1f MW\n储能:%.1f/%.1f\n累计:%.0f MW秒\n蜂群:%d 运算:%.0f\n运算:%.0f 创意:%.0f 信任:%.0f\n", s.PowerProd, s.PowerCons, s.PowerStored, float64(s.Batteries)*s.BatteryCap, s.PowerMWsec, s.TotalDrones, s.SwarmOps, s.Ops, s.Creativity, s.Trust)
+	fmt.Fprintln(b, "达成项目Space Exploration条件进入太空。")
+}
+
+func (m model) compactProjects(p *compactPage, b *strings.Builder) {
+	projects := m.compactProjectList()
+	if len(projects) == 0 {
+		fmt.Fprintln(b, "暂无项目")
+		return
+	}
+	i := clampInt(m.selProject, 0, len(projects)-1)
+	project := projects[i]
+	p.header = append(p.header, fmt.Sprintf(">%d/%d %s", i+1, len(projects), project.Name))
+	fmt.Fprintln(b, project.Name)
+	fmt.Fprintln(b, project.Description)
+	s := m.state
+	fmt.Fprintf(b, "所需/持有 ops:%.0f/%.0f\n创意:%.0f/%.0f yomi:%.0f/%.0f\n信任:%.0f/%.0f 资金:$%.0f/$%.2f\n", project.OpsCost, s.Ops, project.CreatCost, s.Creativity, project.YomiCost, s.Yomi, project.TrustCost, s.Trust, project.FundsCost, s.Funds)
+	if len(project.Prereqs) > 0 {
+		fmt.Fprintln(b, "前置项目: "+strings.Join(project.Prereqs, ", "))
+	}
+	if len(project.OtherPrereqs) > 0 {
+		fmt.Fprintln(b, "其他条件: "+strings.Join(project.OtherPrereqs, ", "))
+	}
+	if s.isProjectResearched(project.Stage, project.Name) {
+		fmt.Fprintln(b, "已完成")
+	} else if s.CanResearch(project) {
+		fmt.Fprintln(b, "可研究: 按r")
+	} else {
+		fmt.Fprintln(b, "条件未满足")
+	}
+	fmt.Fprintln(b, "项目列表 (上下键选择，j/k读详情):")
+	for index, item := range projects {
+		marker := " "
+		if index == i {
+			marker = ">"
+		}
+		status := ""
+		if s.isProjectResearched(item.Stage, item.Name) {
+			status = " [done]"
+		}
+		fmt.Fprintf(b, "%s%d %s%s\n", marker, index+1, item.Name, status)
+	}
+}
+
+func (m model) compactProbes(p *compactPage, b *strings.Builder) {
+	s := m.state
+	names := []string{"速度", "探索", "复制", "避险", "工厂", "采集", "战斗", "信任"}
+	values := []int{s.ProbeSpeed, s.ProbeExplore, s.ProbeReplicate, s.ProbeHazard, s.ProbeFactory, s.ProbeHarvester, s.ProbeCombat, s.ProbeTrust}
+	i := clampInt(m.probeStatSel, 0, 7)
+	selected := fmt.Sprintf(">探针参数: %s %d (上下选 左右调)", names[i], values[i])
+	if m.height <= 10 {
+		selected = fmt.Sprintf(">%s:%d 上下选 左右调 l发射", names[i], values[i])
+	}
+	p.header = append(p.header, selected)
+	fmt.Fprintf(b, "探针:%d 宇宙针:%d\n漂流者:%d 荣誉:%.1f\n", s.Probes, s.UniverseClips, s.Drifters, s.Honor)
+	if s.EndingReached {
+		fmt.Fprintln(b, "宇宙已经充满回形针！")
+	}
+	for index, name := range names {
+		fmt.Fprintf(b, "%s: %d\n", name, values[index])
+	}
+	fmt.Fprintf(b, "l发射花费:%d\n下次复制:%d\n", s.launchCost(), int64(replicateBaseCost))
+}
+
+func (m model) compactControls() []string {
+	var controls []string
+	if m.activeTab == 1 {
+		controls = []string{"上/下选项目 r研究"}
+	} else {
+		switch m.state.CurrentStage {
+		case 1:
+			switch m.activeTab {
+			case 0:
+				controls = []string{"a弯针 w买丝 b自动 u/d调价", "M巨型 m营销 p处理器 e内存"}
+			case 2:
+				controls = []string{"t比赛开关 策略请到项目页研究"}
+			case 3:
+				controls = []string{"i风险 D存入资金 W取出全部"}
+			case 4:
+				controls = []string{"p处理器 e内存 量子请到项目页研究"}
+			case 5:
+				controls = []string{"无人机请到项目页研究"}
+			}
+		case 2:
+			controls = []string{"h采集 w造丝 f工厂 s太阳能 b电池"}
+		case 3:
+			controls = []string{"上/下选参数 左/右调节 l发射"}
+		}
+	}
+	return append(controls, "z/Tab切页 j/k滚动 S存档 q/Esc保存退出")
+}
+
+func (m model) shortControls() []string {
+	if m.saveMenu {
+		return []string{"1-5读 !@#$%写 n新建 d删除", "j/k滚动 S关闭 q/Esc保存退出"}
+	}
+	action := "上/下选项目 r研究"
+	if m.activeTab != 1 {
+		switch m.state.CurrentStage {
+		case 1:
+			action = []string{
+				"a制作 w补丝 b自动 u/d调价", "",
+				"t比赛开关 策略到项目页",
+				"i风险 D存入资金 W取出全部",
+				"p处理器 e内存 量子到项目页",
+				"无人机到项目页研究",
+			}[clampInt(m.activeTab, 0, 5)]
+		case 2:
+			action = "h采集 w造丝 f工厂 s太阳能 b电池"
+		case 3:
+			action = "上/下选参数 左/右调节 l发射"
+		}
+	}
+	return []string{action, "z页 j/k滚 S存档 q/Esc保存退出"}
+}
+
+func (p compactPage) bodyHeight(height int) int {
+	return max(0, height-len(p.header)-len(p.footer)-1)
+}
+
+func (m model) compactMaxScroll() int {
+	p := m.compactPage()
+	return max(0, len(p.body)-max(1, p.bodyHeight(m.height)))
+}
+
+func renderCompact(m model) string {
+	if m.width <= 0 || m.height <= 0 {
+		return ""
+	}
+	p := m.compactPage()
+	h := p.bodyHeight(m.height)
+	offset := clampInt(m.bodyOffset, 0, max(0, len(p.body)-max(1, h)))
+	lines := append([]string{}, p.header...)
+	for i := 0; i < h; i++ {
+		line := ""
+		if offset+i < len(p.body) {
+			line = p.body[offset+i]
+		}
+		lines = append(lines, line)
+	}
+	status := fmt.Sprintf("正文 %d-%d/%d", min(offset+1, len(p.body)), min(offset+h, len(p.body)), len(p.body))
+	if m.message != "" {
+		if m.height <= 10 {
+			status = compactText(m.message)
+		} else {
+			status += " | " + compactText(m.message)
+		}
+	}
+	lines = append(lines, status)
+	lines = append(lines, p.footer...)
+	if len(lines) > m.height {
+		// At tiny heights reserve the available rows for navigation first.
+		lines = lines[len(lines)-m.height:]
+	}
+	for i := range lines {
+		lines[i] = ansi.Truncate(strings.ReplaceAll(compactText(lines[i]), "\n", " "), m.width, "")
+	}
+	return strings.Join(lines, "\n")
+}
