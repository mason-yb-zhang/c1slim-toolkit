+func TestSaveRoundTripAndFailuresPreserveOldSlot(t *testing.T) {
+	m := compactTestModel(t)
+	m.state.PaperclipsTotal = 12345
+	m.state.CurrentStage = 3
+	m.state.ProbeExplore = 7
+	m.state.s3research("Combat")
+	if err := m.saveToSlot(2); err != nil {
+		t.Fatal(err)
+	}
+	m.state.ProbeExplore = 8
+	if err := m.saveToSlot(2); err != nil {
+		t.Fatalf("replace existing save: %v", err)
+	}
+	path := filepath.Join(saveDir(), saveSlotName(2))
+	old, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := *m.state
+	m.state = NewGameState()
+	if err := m.loadFromSlot(2); err != nil || !reflect.DeepEqual(want, *m.state) {
+		t.Fatalf("round trip failed: %v", err)
+	}
+	m.state.Funds = math.NaN()
+	if err := m.saveToSlot(2); err == nil {
+		t.Fatal("invalid JSON number should fail")
+	}
+	got, err := os.ReadFile(path)
+	if err != nil || string(got) != string(old) {
+		t.Fatal("marshal failure changed old save")
+	}
+	m.state.Funds = 0
+	blocked := filepath.Join(saveDir(), saveSlotName(3))
+	if err := os.Mkdir(blocked, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.saveToSlot(3); err == nil || m.currentSlot != 2 {
+		t.Fatal("rename failure changed current slot")
+	}
+	if runtime.GOOS == "windows" {
+		if err := os.Chmod(path, 0444); err != nil {
+			t.Fatal(err)
+		}
+		defer os.Chmod(path, 0644)
+		m.state.PaperclipsTotal = 999
+		if err := m.saveToSlot(2); err == nil {
+			t.Fatal("read-only destination should reject replacement")
+		}
+		got, err = os.ReadFile(path)
+		if err != nil || string(got) != string(old) {
+			t.Fatal("failed replacement changed old save")
+		}
+	}
+	leftovers, err := filepath.Glob(filepath.Join(saveDir(), ".paperclips-save-*"))
+	if err != nil || len(leftovers) != 0 {
+		t.Fatalf("temporary saves leaked: %v %v", leftovers, err)
+	}
+}
