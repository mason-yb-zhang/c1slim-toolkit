+func TestDeviceSaveCompatibility(t *testing.T) {
+	path := os.Getenv("PAPERCLIPS_VERIFY_SAVE")
+	if path == "" {
+		t.Skip("set PAPERCLIPS_VERIFY_SAVE to a read-only save fixture")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var before GameState
+	if err := json.Unmarshal(data, &before); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("XDG_DATA_HOME", t.TempDir())
+	if err := os.MkdirAll(saveDir(), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(saveDir(), saveSlotName(1)), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	m := initialModel()
+	if m.err != nil {
+		t.Fatal(m.err)
+	}
+	if m.state.PaperclipsTotal != before.PaperclipsTotal || m.state.Funds != before.Funds || m.state.CurrentStage != before.CurrentStage || m.state.WireInches != before.WireInches {
+		t.Fatal("loading changed saved progress")
+	}
+}
