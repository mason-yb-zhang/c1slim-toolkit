diff --git a/save_errors_test.go b/save_errors_test.go
new file mode 100644
index 0000000..ea33ea4
--- /dev/null
+++ b/save_errors_test.go
@@ -0,0 +1,226 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	tea "github.com/charmbracelet/bubbletea"
+)
+
+func blockSaveSlot(t *testing.T, slot int) string {
+	t.Helper()
+	path := filepath.Join(saveDir(), saveSlotName(slot))
+	if err := os.MkdirAll(path, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(path, "keep"), []byte("original"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestQuitFailureStaysInGameAndRetrySucceeds(t *testing.T) {
+	for _, key := range []tea.KeyMsg{{Type: tea.KeyRunes, Runes: []rune("q")}, {Type: tea.KeyEscape}, {Type: tea.KeyCtrlC}} {
+		t.Run(key.String(), func(t *testing.T) {
+			m := compactTestModel(t)
+			m.state.PaperclipsTotal = 123
+			before := *m.state
+			blocked := blockSaveSlot(t, 1)
+			next, cmd := m.Update(key)
+			m = next.(model)
+			if cmd != nil || m.err == nil || m.err.Error() == "QUIT" || !strings.Contains(m.message, "保存退出失败") {
+				t.Fatalf("failed save must not quit: cmd=%v err=%v message=%s", cmd != nil, m.err, m.message)
+			}
+			if !reflect.DeepEqual(before, *m.state) || m.currentSlot != 1 {
+				t.Fatal("failed quit changed game state")
+			}
+			if !strings.Contains(m.View(), "保存退出失败") {
+				t.Fatal("save failure not visible")
+			}
+			assertCompactBounds(t, m)
+			if err := os.Remove(filepath.Join(blocked, "keep")); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Remove(blocked); err != nil {
+				t.Fatal(err)
+			}
+			next, cmd = m.Update(key)
+			m = next.(model)
+			if cmd == nil || m.err != nil {
+				t.Fatalf("successful retry did not quit: %v", m.err)
+			}
+			if _, ok := cmd().(tea.QuitMsg); !ok {
+				t.Fatal("expected quit command")
+			}
+			if err := m.loadFromSlot(1); err != nil || m.state.PaperclipsTotal != 123 {
+				t.Fatalf("retry did not persist progress: %v", err)
+			}
+		})
+	}
+}
+
+func TestFailedSaveActionsPreserveStateAndDoNotClaimSuccess(t *testing.T) {
+	for _, key := range []string{"s", "!", "@", "#", "$", "%", "n", "d", "2"} {
+		t.Run(key, func(t *testing.T) {
+			m := compactTestModel(t)
+			m.state.PaperclipsTotal, m.state.Funds = 777, 23
+			before := *m.state
+			for slot := 1; slot <= 5; slot++ {
+				blockSaveSlot(t, slot)
+			}
+			if key != "s" {
+				press(&m, "S")
+			}
+			press(&m, key)
+			if m.err == nil || !strings.Contains(m.message, "失败") || strings.Contains(m.message, "Saved") || strings.Contains(m.message, "Loaded") {
+				t.Fatalf("false success: %v %s", m.err, m.message)
+			}
+			if !reflect.DeepEqual(before, *m.state) || m.currentSlot != 1 {
+				t.Fatal("failed action mutated memory/slot")
+			}
+			if key != "s" && !m.saveMenu {
+				t.Fatal("failed menu action should leave menu open")
+			}
+			for slot := 1; slot <= 5; slot++ {
+				data, err := os.ReadFile(filepath.Join(saveDir(), saveSlotName(slot), "keep"))
+				if err != nil || string(data) != "original" {
+					t.Fatalf("failed action changed slot %d", slot)
+				}
+			}
+			assertCompactBounds(t, m)
+		})
+	}
+}
+
+func TestFailedSlotLoadPreservesStateAndMenu(t *testing.T) {
+	m := compactTestModel(t)
+	m.state.PaperclipsTotal = 1234
+	before := *m.state
+	if err := os.MkdirAll(saveDir(), 0755); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(saveDir(), saveSlotName(2))
+	for _, data := range []string{"{broken", "null", "{}", `{"unknown":1}`, `{"current_stage":null}`, `{"paperclips_total":null}`, `{"current_stage":99}`} {
+		if err := os.WriteFile(path, []byte(data), 0644); err != nil {
+			t.Fatal(err)
+		}
+		m.saveMenu = true
+		press(&m, "2")
+		if m.err == nil || !m.saveMenu || !strings.Contains(m.message, "读取失败") || m.currentSlot != 1 || !reflect.DeepEqual(before, *m.state) {
+			t.Fatal("corrupt load did not preserve old state")
+		}
+		got, err := os.ReadFile(path)
+		if err != nil || string(got) != data {
+			t.Fatal("corrupt input was changed")
+		}
+	}
+}
+
+func TestAutoSaveFailurePersistsThenRecovers(t *testing.T) {
+	m := compactTestModel(t)
+	blocked := blockSaveSlot(t, 1)
+	m.autoSaveTimer = 60
+	next, _ := m.Update(tickMsg{})
+	m = next.(model)
+	if m.err == nil || !strings.Contains(m.message, "自动保存失败") || m.messageTimer != 0 {
+		t.Fatal("autosave failure was hidden")
+	}
+	for i := 0; i < 100; i++ {
+		next, _ = m.Update(tickMsg{})
+		m = next.(model)
+	}
+	if !strings.Contains(m.message, "自动保存失败") {
+		t.Fatal("error disappeared before recovery")
+	}
+	if err := os.Remove(filepath.Join(blocked, "keep")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(blocked); err != nil {
+		t.Fatal(err)
+	}
+	m.autoSaveTimer = 60
+	next, _ = m.Update(tickMsg{})
+	m = next.(model)
+	if m.err != nil || m.message != "自动保存成功" {
+		t.Fatal("autosave recovery did not clear error")
+	}
+}
+
+func TestCorruptStartupStopsTicksInputsAndWrites(t *testing.T) {
+	for _, data := range []string{"{broken", "null", "{}", `{"unknown":1}`, `{"current_stage":null}`, `{"paperclips_total":null}`, `{"current_stage":99}`} {
+		t.Run(data, func(t *testing.T) {
+			compactTestModel(t)
+			if err := os.MkdirAll(saveDir(), 0755); err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(saveDir(), saveSlotName(1))
+			if err := os.WriteFile(path, []byte(data), 0644); err != nil {
+				t.Fatal(err)
+			}
+			m := initialModel()
+			if !m.loadFailed || m.err == nil || m.Init() != nil {
+				t.Fatal("corrupt startup was allowed to run")
+			}
+			before := *m.state
+			m.autoSaveTimer = 60
+			for _, msg := range []tea.Msg{tickMsg{}, tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune("a")}, tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune("s")}, tea.KeyMsg{Type: tea.KeyEscape}} {
+				next, cmd := m.Update(msg)
+				m = next.(model)
+				if cmd != nil || !reflect.DeepEqual(before, *m.state) {
+					t.Fatal("failed startup processed gameplay or scheduled ticks")
+				}
+			}
+			if err := m.saveCurrent(); err == nil {
+				t.Fatal("failed startup allowed direct save")
+			}
+			got, err := os.ReadFile(path)
+			if err != nil || string(got) != data {
+				t.Fatal("startup replaced damaged save")
+			}
+		})
+	}
+}
+
+func TestDeletingCurrentSlotDoesNotRedirectAutosave(t *testing.T) {
+	m := compactTestModel(t)
+	m.state.PaperclipsTotal = 111
+	if err := m.saveToSlot(1); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(saveDir(), saveSlotName(1))
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.state.PaperclipsTotal = 333
+	if err := m.saveToSlot(3); err != nil {
+		t.Fatal(err)
+	}
+	press(&m, "S")
+	press(&m, "d")
+	if m.currentSlot != 3 || m.state.PaperclipsTotal != 0 || m.saveMenu {
+		t.Fatal("delete redirected active slot")
+	}
+	m.autoSaveTimer = 60
+	next, _ := m.Update(tickMsg{})
+	m = next.(model)
+	after, err := os.ReadFile(path)
+	if err != nil || string(after) != string(before) {
+		t.Fatal("delete followed by autosave overwrote slot 1")
+	}
+}
+
+func TestHealthyStartupStillLoadsAndRuns(t *testing.T) {
+	m := compactTestModel(t)
+	m.state.PaperclipsTotal = 987
+	if err := m.saveToSlot(3); err != nil {
+		t.Fatal(err)
+	}
+	loaded := initialModel()
+	if loaded.loadFailed || loaded.err != nil || loaded.currentSlot != 3 || loaded.state.PaperclipsTotal != 987 || loaded.Init() == nil {
+		t.Fatalf("healthy startup changed: %v", loaded.err)
+	}
+}
