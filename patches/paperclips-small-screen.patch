+
+func compactTestModel(t *testing.T) model {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_DATA_HOME", filepath.Join(home, "data"))
+	return model{state: NewGameState(), currentSlot: 1, width: 49, height: 18}
+}
+
+func press(m *model, key string) {
+	m.handleKey(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune(key)})
+}
+
+func assertCompactBounds(t *testing.T, m model) {
+	t.Helper()
+	view := m.View()
+	lines := strings.Split(view, "\n")
+	if len(lines) > m.height {
+		t.Fatalf("%d lines > %d:\n%s", len(lines), m.height, view)
+	}
+	for i, line := range lines {
+		if ansi.StringWidth(line) > m.width {
+			t.Fatalf("line %d width %d > %d: %q", i, ansi.StringWidth(line), m.width, line)
+		}
+	}
+	if strings.ContainsAny(view, "📎📌💡💬🌟✅▶⏸\ufe0f") {
+		t.Fatalf("emoji left in compact view: %s", view)
+	}
+}
+
+func TestCompactAllStagesTabsAndSizes(t *testing.T) {
+	m := compactTestModel(t)
+	for _, size := range [][2]int{{37, 8}, {37, 9}, {49, 18}, {60, 22}, {61, 22}, {60, 23}, {32, 12}, {1, 1}, {2, 3}} {
+		m.width, m.height = size[0], size[1]
+		for stage := 1; stage <= 3; stage++ {
+			m.state.CurrentStage = stage
+			for tab := 0; tab < m.compactTabCount(); tab++ {
+				m.activeTab = tab
+				m.state.AlgoTrading = true
+				m.state.StrategicModeling = true
+				m.state.StrategiesUnlocked = 255
+				m.state.QuantumComputing = true
+				m.state.CreativeIdle = true
+				m.state.CombatUnlocked = true
+				m.state.research("HypnoDrones")
+				for _, offset := range []int{0, 99999} {
+					m.bodyOffset = offset
+					m.message = "\x1b[31m提示: 很长的反馈 " + strings.Repeat("宽", 90) + "\x1b[0m"
+					for _, menu := range []bool{false, true} {
