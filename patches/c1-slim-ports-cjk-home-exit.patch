+// runeWidth reports 2 for wide (CJK) runes, 1 otherwise.
+func runeWidth(c rune) int {
+	switch {
+	case c >= 0x1100 && c <= 0x115F,
+		c >= 0x2E80 && c <= 0xA4CF && c != 0x303F,
+		c >= 0xAC00 && c <= 0xD7A3,
