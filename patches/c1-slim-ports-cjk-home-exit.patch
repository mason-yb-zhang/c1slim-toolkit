+		c >= 0xFE30 && c <= 0xFE4F,
+		c >= 0xFF00 && c <= 0xFF60,
+		c >= 0xFFE0 && c <= 0xFFE6,
+		c >= 0x20000 && c <= 0x3FFFD:
+		return 2
+	}
+	return 1
