+// drawWideCJK draws a 12x8 glyph across two 6px cells.
+func drawWideCJK(frame []byte, x, y int, bmp [16]byte, inverse, underline bool) {
+	for column := 0; column < 12; column++ {
+		for row := 0; row < 8; row++ {
+			set := bmp[row*2+column/8]&(0x80>>(column%8)) != 0
+			if underline && row == 6 {
+				set = true
+			}
+			setPixel(frame, x+column, y+row, set != inverse)
