+func cjkBitmap(r rune) ([16]byte, bool) {
+	lo, hi := 0, len(cjkTable)-1
+	for lo <= hi {
+		mid := (lo + hi) / 2
+		if cjkTable[mid].cp < r {
+			lo = mid + 1
+		} else if cjkTable[mid].cp > r {
+			hi = mid - 1
+		} else {
+			return cjkTable[mid].bmp, true
+		}
+	}
+	return [16]byte{}, false
+}
